<?xml version="1.0"?>
<package format="3">
  <name>simplest_course_drone</name>
  <version>0.2.0</version>
  <description>Fly the course from the map, self-contained: planner, map frame and checkpoints, sensor fusion and the flight-tested step engine all live in this package.</description>
  <maintainer email="noreply@example.com">DroneHacks team</maintainer>
  <license>Apache-2.0</license>

  <!-- ROS 2 and the organisers' kit only: no other team package -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>skybeta_flight_interface</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
