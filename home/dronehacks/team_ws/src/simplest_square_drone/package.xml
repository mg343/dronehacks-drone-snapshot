<?xml version="1.0"?>
<package format="3">
  <name>simplest_square_drone</name>
  <version>0.1.0</version>
  <description>The square_circle cage test (square, touch-and-go, circle, land) written as a plain step list in steps.py.</description>
  <maintainer email="linchenyoung1126@gmail.com">TheSleepyPP</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>skybeta_flight_interface</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
